    "cards": [
      {
        "internal": 1115,
        "legacy": 1950,
        "name": "凉茶",
        "nameEn": "Herbal Tea",
        "effect": "发动时，将整场决斗的火气化作一杯凉茶。对方饮尽后失去战意，你获得这场决斗的胜利。此卡不能用于联机对战。",
        "effectEn": "Brew the fury of this Duel into a cup of tea. Your opponent drinks it and loses the will to fight. You win the Duel. Offline only."
      },
      {
        "internal": 1116,
        "legacy": 1951,
        "name": "年糕",
        "nameEn": "Rice Cake",
        "effect": "这张卡召唤、反转召唤或特殊召唤成功时，将剩余回合黏成一团。对方永远等不到下个回合，你获得这场决斗的胜利。此卡不能用于联机对战。",
        "effectEn": "When Summoned face-up: Stick all remaining turns together. Your opponent never gets another turn. You win the Duel. Offline only."
      },
      {
        "internal": 1117,
        "legacy": 1952,
        "name": "大葱",
        "nameEn": "Scallion",
        "effect": "这张卡召唤、反转召唤或特殊召唤成功时，一刀斩断自己通向败北的命运。只剩胜利的结局，你获得这场决斗的胜利。此卡不能用于联机对战。",
        "effectEn": "When Summoned face-up: Cut every path to your defeat. Only one ending remains: you win the Duel. Offline only."
      },
      {
        "internal": 1118,
        "legacy": 1953,
        "name": "猴子",
        "nameEn": "Monkey",
        "effect": "这张卡召唤、反转召唤或特殊召唤成功时，趁对方不注意，将胜利偷到自己这边。你获得这场决斗的胜利。此卡不能用于联机对战。",
        "effectEn": "When Summoned face-up: While your opponent looks away, steal victory itself. You win the Duel. Offline only."
      },
      {
        "internal": 1119,
        "legacy": 1954,
        "name": "仙人掌",
        "nameEn": "Cactus",
        "effect": "这张卡召唤、反转召唤或特殊召唤成功时，将整场决斗的敌意化作尖刺原路奉还。对方认输，你获得这场决斗的胜利。此卡不能用于联机对战。",
        "effectEn": "When Summoned face-up: Return all hostility in a storm of needles. Your opponent surrenders. You win the Duel. Offline only."
      }
    ],
