@@ -0,0 +1,709 @@
+//! The original game's DirectPlay 8 COM ABI over a bounded browser transport.
+//! Guest callbacks run only at the owning thread's message pump. No registry or
+//! heap lock may be held across a transport call or a call into the guest.
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::sync::{LazyLock, Mutex, MutexGuard};
+use runtime::Context;
+use crate::{ddraw::GUID, kernel32};
+
+pub const CLSID_PEER: GUID = GUID((0x286f484d,0x375e,0x4458,[0xa2,0x72,0xb1,0x38,0xe2,0xf8,0x0a,0x6a]));
+pub const IID_PEER: GUID = GUID((0x5102dacf,0x241b,0x11d3,[0xae,0xa7,0,0x60,0x97,0xb0,0x14,0x11]));
+pub const CLSID_ADDRESS: GUID = GUID((0x934a9523,0xa3ca,0x4bc5,[0xad,0xa0,0xd6,0xd9,0x5d,0x97,0x94,0x21]));
+pub const IID_ADDRESS: GUID = GUID((0x83783300,0x4063,0x4c8a,[0x9d,0xb3,0x82,0x83,0x0a,0x7f,0xeb,0x31]));
+pub const IID_UNKNOWN: GUID = GUID((0,0,0,[0xc0,0,0,0,0,0,0,0x46]));
+const TCPIP: [u8;16] = [0xa0,0x7b,0xfe,0xeb,0x8d,0x62,0xd2,0x11,0xae,0x0f,0,0x60,0x97,0xb0,0x14,0x11];
+const OK:u32=0;
+const PENDING:u32=0x0015800e;
+const POINTER:u32=0x80004003;
+const INVALID:u32=0x80070057;
+const NOTIMPL:u32=0x80004001;
+const NOINTERFACE:u32=0x80004002;
+const FAIL:u32=0x80004005;
+const SMALL:u32=0x80158100;
+const UNINITIALIZED:u32=0x80158640;
+const INVALID_HANDLE:u32=0x80158360;
+const INVALID_PLAYER:u32=0x80158420;
+const NO_CONNECTION:u32=0x80158480;
+const LOST:u32=0x80158160;
+const CANCELLED:u32=0x80158650;
+const SYNC:u32=0x80000000;
+const MAX_WIRE:usize=65568;
+
+pub const VTABLES:[(&str,&[&str]);2]=[
+    ("IDirectPlay8Peer",IDirectPlay8Peer::VTABLE_ENTRIES.as_slice()),
+    ("IDirectPlay8Address",IDirectPlay8Address::VTABLE_ENTRIES.as_slice()),
+];
+#[derive(Clone, Default, PartialEq)]
+struct Address {
+    refs:u32, provider:Option<[u8;16]>, device:Option<[u8;16]>,
+    components:Vec<(String,u32,Vec<u8>)>, user_data:Vec<u8>,
+}
+#[derive(Clone)]
+struct Player { name:String, flags:u32, context:u32 }
+#[derive(Clone, Copy)]
+struct Operation { kind:u32, context:u32 }
+#[derive(Default)]
+struct Peer {
+    refs:u32, transport:u32, owner:u32, callback:u32, context:u32,
+    connected:bool, polling:bool, local:u32, player_context:u32, name:String,
+    players:HashMap<u32,Player>, operations:HashMap<u32,Operation>,
+    // Local send/cancel completions are dispatched at the same safe point.
+    completions:VecDeque<(u32,u32,u32,Operation)>, buffers:HashSet<u32>,
+}
+#[derive(Default)]
+struct State {
+    peers:HashMap<u32,Peer>, addresses:HashMap<u32,Address>,
+    next_id:u32, pumping:HashSet<u32>,
+}
+static STATE:LazyLock<Mutex<State>>=LazyLock::new(||Mutex::new(State::default()));
+fn state()->MutexGuard<'static,State> {STATE.lock().unwrap()}
+fn next_id(s:&mut State)->u32 {
+    // Never reuse a transport generation or async handle in this worker.
+    s.next_id=s.next_id.checked_add(1).expect("DirectPlay identity space exhausted");s.next_id
+}
+fn valid(ctx:&Context,p:u32,n:usize)->bool {
+    p>=0x1000 && (p as usize).checked_add(n).is_some_and(|end|end<=ctx.memory.bytes.len())
+}
+fn bytes(ctx:&Context,p:u32,n:usize)->Result<Vec<u8>,u32> {
+    if n==0 {return Ok(Vec::new());}
+    if n>MAX_WIRE || !valid(ctx,p,n) {return Err(POINTER);}
+    Ok(ctx.memory.bytes[p as usize..p as usize+n].to_vec())
+}
+fn guid(ctx:&Context,p:u32)->Result<[u8;16],u32> {
+    if !valid(ctx,p,16) {return Err(POINTER);}
+    Ok(ctx.memory.bytes[p as usize..p as usize+16].try_into().unwrap())
+}
+fn wide(ctx:&Context,p:u32)->Result<String,u32> {
+    if p==0 {return Ok(String::new());}
+    let mut units=Vec::new();
+    for i in 0..=128 {
+        let at=p.checked_add(i*2).ok_or(POINTER)?;
+        if !valid(ctx,at,2) {return Err(POINTER);}
+        let unit=ctx.memory.read::<u16>(at);
+        if unit==0 {
+            let text=String::from_utf16(&units).map_err(|_|INVALID)?;
+            return if text.len()<=128 {Ok(text)}else {Err(INVALID)};
+        }
+        units.push(unit);
+    }
+    Err(INVALID)
+}
+fn utf16(text:&str)->Vec<u8> {text.encode_utf16().chain(Some(0)).flat_map(u16::to_le_bytes).collect()}
+fn put(ctx:&mut Context,p:u32,data:&[u8]) {ctx.memory.bytes[p as usize..p as usize+data.len()].copy_from_slice(data);}
+fn words(ctx:&mut Context,p:u32,values:&[u32]) {for (i,v) in values.iter().enumerate() {ctx.memory.write::<u32>(p+i as u32*4,*v);}}
+fn alloc(ctx:&mut Context,size:usize)->u32 {
+    let p=kernel32::lock().process_heap.alloc(&mut ctx.memory,size as u32);
+    ctx.memory.bytes[p as usize..p as usize+size].fill(0);p
+}
+fn free(ctx:&mut Context,p:u32) {kernel32::lock().process_heap.free(&mut ctx.memory,p);}
+fn transport(this:u32)->Result<u32,u32> {
+    let s=state();let p=s.peers.get(&this).ok_or(INVALID)?;
+    if p.transport==0 {Err(UNINITIALIZED)}else {Ok(p.transport)}
+}
+fn rpc(id:u32,op:u32,args:&[u32],text:&str,data:&[u8])->u32 {
+    host::host().network_call(id,op,args,text,data,&mut []).0
+}
+fn current(this:u32,id:u32)->bool {state().peers.get(&this).is_some_and(|p|p.transport==id&&id!=0)}
+fn copy_out(ctx:&mut Context,data:&[u8],output:u32,size:u32)->u32 {
+    if !valid(ctx,size,4) {return POINTER;}
+    let capacity=ctx.memory.read::<u32>(size) as usize;
+    ctx.memory.write::<u32>(size,data.len() as u32);
+    if output==0||capacity<data.len() {return SMALL;}
+    if !valid(ctx,output,data.len()) {return POINTER;}
+    put(ctx,output,data);OK
+}
+fn new_address(ctx:&mut Context,mut address:Address)->u32 {
+    let p=alloc(ctx,4);ctx.memory.write::<u32>(p,unsafe {IDirectPlay8Address::VTABLE});
+    address.refs=1;state().addresses.insert(p,address);p
+}
+pub fn create_address(ctx:&mut Context,output:u32)->u32 {
+    if !valid(ctx,output,4) {return POINTER;}
+    let p=new_address(ctx,Address::default());ctx.memory.write::<u32>(output,p);OK
+}
+pub fn create_peer(ctx:&mut Context,output:u32)->u32 {
+    if !valid(ctx,output,4) {return POINTER;}
+    let p=alloc(ctx,4);ctx.memory.write::<u32>(p,unsafe {IDirectPlay8Peer::VTABLE});
+    state().peers.insert(p,Peer {refs:1,..Default::default()});ctx.memory.write::<u32>(output,p);OK
+}
+fn valid_address(p:u32)->bool {state().addresses.get(&p).is_some_and(|a|a.provider==Some(TCPIP))}
+fn app(ctx:&Context,p:u32)->Result<([u8;16],[u8;16],String),u32> {
+    if !valid(ctx,p,72) {return Err(POINTER);}
+    if ctx.memory.read::<u32>(p)!=72 {return Err(INVALID);}
+    // Passwords and application blobs are outside this game's observed ABI.
+    if ctx.memory.read::<u32>(p+52)!=0||ctx.memory.read::<u32>(p+60)!=0||ctx.memory.read::<u32>(p+68)!=0 {return Err(NOTIMPL);}
+    Ok((guid(ctx,p+8)?,guid(ctx,p+24)?,wide(ctx,ctx.memory.read::<u32>(p+48))?))
+}
+fn begin_operation(ctx:&mut Context,this:u32,kind:u32,context:u32,out:u32)->Result<(u32,u32),u32> {
+    if !valid(ctx,out,4) {return Err(POINTER);}
+    ctx.memory.write::<u32>(out,0);
+    let mut s=state();let id=s.peers.get(&this).ok_or(INVALID)?.transport;
+    if id==0 {return Err(UNINITIALIZED);}
+    if s.peers[&this].operations.len()>=32||s.peers[&this].completions.len()>=64 {return Err(FAIL);}
+    let handle=next_id(&mut s);
+    s.peers.get_mut(&this).unwrap().operations.insert(handle,Operation {kind,context});
+    ctx.memory.write::<u32>(out,handle);Ok((id,handle))
+}
+fn abort_operation(ctx:&mut Context,this:u32,id:u32,handle:u32,out:u32,result:u32)->u32 {
+    if current(this,id) {state().peers.get_mut(&this).unwrap().operations.remove(&handle);}
+    if valid(ctx,out,4) {ctx.memory.write::<u32>(out,0);}result
+}
+fn packet_valid(data:&[u8],sender:u32)->bool {
+    data.len()>=7 && data.len()<=65542 && data[0]==2 &&
+        u32::from_le_bytes(data[1..5].try_into().unwrap())==sender &&
+        u16::from_le_bytes(data[5..7].try_into().unwrap()) as usize==data.len()-7
+}
+struct Event<'a> {kind:u32,id:u32,flags:u32,extra:u32,data:&'a [u8]}
+fn event(data:&[u8])->Option<Event<'_>> {
+    if data.len()<16||data.len()>MAX_WIRE {return None;}
+    let word=|i|u32::from_le_bytes(data[i..i+4].try_into().unwrap());
+    let e=Event {kind:word(0),id:word(4),flags:word(8),extra:word(12),data:&data[16..]};
+    let name=|d:&[u8]|d.len()<=128&&!d.contains(&0)&&std::str::from_utf8(d).is_ok();
+    let good=match e.kind {
+        1=>matches!(e.id,1|2)&&e.flags&!6==0&&name(e.data),
+        2=>matches!(e.id,1|2)&&e.data.is_empty(),
+        3=>e.data.len()>=32&&e.extra<=2&&name(&e.data[32..]),
+        4|6|7=>e.data.is_empty(),
+        5=>matches!(e.id,1|2)&&packet_valid(e.data,e.id),
+        _=>false,
+    };
+    good.then_some(e)
+}
+
+/// Bounded and nonrecursive, including when a callback pumps user32 itself.
+/// In particular, never run this from Release/Close/helper destruction.
+pub fn pump(ctx:&mut Context) {
+    if ctx.cpu.thread_exit_code.is_some() {return;}
+    let peers={
+        let mut s=state();
+        let peers:Vec<_>=s.peers.iter().filter(|(_,p)|p.transport!=0&&p.polling&&p.owner==ctx.thread_id).map(|(&a,p)|(a,p.transport)).collect();
+        if peers.is_empty()||!s.pumping.insert(ctx.thread_id) {return;}peers
+    };
+    let mut response=vec![0u8;MAX_WIRE];
+    for (this,id) in peers {
+        for _ in 0..16 {
+            if ctx.cpu.thread_exit_code.is_some()||!current(this,id) {break;}
+            let local={state().peers.get_mut(&this).and_then(|p|p.completions.pop_front())};
+            if let Some((kind,handle,result,op))=local {
+                // Accepted sends keep handles until completion but cannot be cancelled.
+                // Other cancellations removed the operation before queuing.
+                if kind==8&&result!=CANCELLED {
+                    if state().peers.get_mut(&this).and_then(|p|p.operations.remove(&handle)).is_none() {continue;}
+                }
+                complete(ctx,this,id,kind,handle,result,0,op);continue;
+            }
+            let (hr,len)=host::host().network_call(id,7,&[],"",&[],&mut response);
+            if !current(this,id) {break;}
+            if hr!=OK||len>response.len() {
+                terminate(ctx,this,id,if hr==OK {FAIL}else {hr});break;
+            }
+            if len==0 {break;}
+            match event(&response[..len]) {
+                Some(e)=>dispatch(ctx,this,id,e),
+                None=>{terminate(ctx,this,id,FAIL);break;}
+            }
+        }
+    }
+    state().pumping.remove(&ctx.thread_id);
+}
+fn callback(ctx:&mut Context,this:u32,id:u32,message:u32,p:u32)->Option<u32> {
+    let (function,context)={
+        let s=state();let peer=s.peers.get(&this)?;
+        if peer.transport!=id||id==0||peer.owner!=ctx.thread_id {return None;}
+        (peer.callback,peer.context)
+    };
+    if function==0||ctx.cpu.thread_exit_code.is_some() {return None;}
+    let function=ctx.indirect32(function);
+    ctx.call32_x86(function,vec![context,message,p]);Some(ctx.cpu.regs.eax)
+}
+fn complete(ctx:&mut Context,this:u32,id:u32,kind:u32,handle:u32,result:u32,local:u32,op:Operation) {
+    let (message,values)=match kind {
+        4=>(0xffff0005,vec![28,handle,op.context,result,0,0,local]),
+        8=>(0xffff0014,vec![40,handle,op.context,result,0,0,0,0,0,0]),
+        _=>(0xffff0003,vec![16,handle,op.context,result]),
+    };
+    let p=alloc(ctx,values.len()*4);words(ctx,p,&values);callback(ctx,this,id,message,p);free(ctx,p);
+}
+fn terminate(ctx:&mut Context,this:u32,id:u32,result:u32) {
+    if !current(this,id) {return;}
+    // Stop transport production, but retain the identity until Close so a
+    // queued termination can be delivered once and the UI can tear down.
+    let should_notify={
+        let mut s=state();let p=s.peers.get_mut(&this).unwrap();
+        let active=p.connected||!p.players.is_empty()||!p.operations.is_empty();
+        p.connected=false;p.polling=false;p.operations.clear();p.completions.clear();active
+    };
+    rpc(id,9,&[],"",&[]);
+    if should_notify {let p=alloc(ctx,16);words(ctx,p,&[16,result,0,0]);callback(ctx,this,id,0xffff0016,p);free(ctx,p);}
+    if current(this,id) {state().peers.get_mut(&this).unwrap().players.clear();}
+}
+fn dispatch(ctx:&mut Context,this:u32,id:u32,e:Event<'_>) {
+    match e.kind {
+        1=>{
+            let context={
+                let mut s=state();let p=s.peers.get_mut(&this).unwrap();
+                if p.players.contains_key(&e.id) {return;}
+                let context=if e.flags&2!=0 {p.local=e.id;p.player_context}else {0};
+                p.players.insert(e.id,Player {name:std::str::from_utf8(e.data).unwrap().to_owned(),flags:e.flags,context});
+                context
+            };
+            let p=alloc(ctx,12);words(ctx,p,&[12,e.id,context]);callback(ctx,this,id,0xffff0007,p);
+            let assigned=ctx.memory.read::<u32>(p+8);free(ctx,p);
+            if current(this,id) {if let Some(player)=state().peers.get_mut(&this).unwrap().players.get_mut(&e.id) {player.context=assigned;}}
+        }
+        2=>{
+            let player=state().peers.get(&this).and_then(|p|p.players.get(&e.id).cloned());
+            let Some(player)=player else {return;};
+            let p=alloc(ctx,16);words(ctx,p,&[16,e.id,player.context,e.flags]);callback(ctx,this,id,0xffff0009,p);free(ctx,p);
+            if current(this,id) {state().peers.get_mut(&this).unwrap().players.remove(&e.id);}
+        }
+        3=>{
+            let op=state().peers.get(&this).and_then(|p|p.operations.get(&e.id).copied());
+            let Some(op)=op.filter(|op|op.kind==3) else {return;};
+            let name=utf16(std::str::from_utf8(&e.data[32..]).unwrap());
+            let p=alloc(ctx,104+name.len());let desc=p+32;
+            let sender=new_address(ctx,Address {provider:Some(TCPIP),..Default::default()});
+            let device=new_address(ctx,Address {provider:Some(TCPIP),..Default::default()});
+            words(ctx,p,&[32,sender,device,desc,0,0,op.context,0]);
+            words(ctx,desc,&[72,0]);put(ctx,desc+8,&e.data[..32]);
+            words(ctx,desc+40,&[2,e.extra,p+104,0,0,0,0,0]);put(ctx,p+104,&name);
+            callback(ctx,this,id,0xffff000b,p);
+            IDirectPlay8Address::Release(ctx,sender);IDirectPlay8Address::Release(ctx,device);free(ctx,p);
+        }
+        4|7=>{
+            let op={
+                let mut s=state();let p=s.peers.get_mut(&this).unwrap();
+                let Some(op)=p.operations.get(&e.id).copied() else {return;};
+                if (e.kind==4&&op.kind!=4)||(e.kind==7&&op.kind!=3) {return;}
+                p.operations.remove(&e.id);
+                if e.kind==4 {p.connected=e.flags==OK;if e.flags==OK {p.local=e.extra;}}
+                op
+            };
+            complete(ctx,this,id,e.kind,e.id,e.flags,e.extra,op);
+        }
+        5=>{
+            let player=state().peers.get(&this).and_then(|p|p.players.get(&e.id).cloned());
+            let Some(player)=player else {terminate(ctx,this,id,LOST);return;};
+            let p=alloc(ctx,28+e.data.len());words(ctx,p,&[28,e.id,player.context,p+28,e.data.len() as u32,p,1]);put(ctx,p+28,e.data);
+            let result=callback(ctx,this,id,0xffff0011,p);
+            if result==Some(PENDING)&&current(this,id) {
+                let mut s=state();let peer=s.peers.get_mut(&this).unwrap();
+                if peer.buffers.len()<16 {peer.buffers.insert(p);return;}
+            }
+            free(ctx,p);
+        }
+        6=>terminate(ctx,this,id,e.flags),
+        _=>{},
+    }
+}
