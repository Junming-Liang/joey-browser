index 0000000..4bfe396
--- /dev/null
+++ b/win32/winapi/src/user32/keyboard.rs
@@ -0,0 +1,122 @@
+//! Original game's scan-code-zero ToAscii path for the fixed reference
+//! Chinese keyboard layout. This does not implement IME or all layouts.
+use crate::{Ptr, kernel32::SetLastError};
+use runtime::Context;
+const TABLE: &[u8; 16384] = include_bytes!("keyboard_data.bin");
+const KEYMAP: &[u8; 15360] = include_bytes!("keymap_data.bin");
+const REFERENCE_LAYOUT: u32 = 0xe0010804;
+
+#[win32_derive::dllexport]
+pub fn GetKeyboardLayout(ctx: &mut Context, idThread: u32) -> u32 {
+    if idThread == 0 || idThread == ctx.thread_id {
+        return REFERENCE_LAYOUT;
+    }
+    // All currently created virtual threads inherit this one layout. Layout
+    // activation and IME language changes are not implemented by this port.
+    if idThread < crate::kernel32::lock().next_thread_id {
+        REFERENCE_LAYOUT
+    } else {
+        0
+    }
+}
+
+#[win32_derive::dllexport]
+pub fn MapVirtualKeyA(_ctx: &mut Context, uCode: u32, uMapType: u32) -> u32 {
+    if uMapType > 4 {
+        return 0;
+    }
+    let group = match uCode & !0xff {
+        0 => 0,
+        0xe000 => 1,
+        0xe100 => 2,
+        _ => unimplemented!("MapVirtualKeyA code prefix {uCode:x}"),
+    };
+    let offset = ((group * 5 + uMapType) * 256 + (uCode & 255)) as usize * 4;
+    u32::from_le_bytes(KEYMAP[offset..][..4].try_into().unwrap())
+}
+
+#[win32_derive::dllexport]
+pub fn ToAscii(
+    ctx: &mut Context,
+    uVirtKey: u32,
+    uScanCode: u32,
+    lpKeyState: Ptr<u8>,
+    lpChar: Ptr<u8>,
+    uFlags: u32,
+) -> i32 {
+    if uScanCode != 0 || uFlags != 0 {
+        unimplemented!("ToAscii scan={uScanCode:x} flags={uFlags:x}");
+    }
+    if lpChar.addr == 0 {
+        SetLastError(ctx, 87);
+        return 0;
+    }
+    if uVirtKey > 255 {
+        return 0;
+    }
+    let keys = if lpKeyState.addr == 0 {
+        let state = crate::user32::state().input.borrow();
+        std::array::from_fn(|index| state.key_state(index as u8))
+    } else {
+        <[u8; 256]>::try_from(&ctx.memory[lpKeyState.addr..][..256]).unwrap()
+    };
+    let modifiers = (u32::from(keys[0x10] & 0x80 != 0))
+        | (u32::from(keys[0x11] & 0x80 != 0) << 1)
+        | (u32::from(keys[0x12] & 0x80 != 0) << 2)
+        | (u32::from(keys[0x14] & 1 != 0) << 3);
+    let offset = (modifiers * 256 + uVirtKey) as usize * 4;
+    let cell = &TABLE[offset..][..4];
+    // Return value counts translated characters, not encoded ANSI bytes.
+    // Preserve every byte the actual reference call left untouched.
+    ctx.memory[lpChar.addr..][..cell[2] as usize].copy_from_slice(&cell[..cell[2] as usize]);
+    cell[3] as i32
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn control_return_dbcs_and_no_character_preserve_reference_buffer_bytes() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(16384),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        assert_eq!(GetKeyboardLayout(&mut ctx, 0), 0xe0010804);
+        assert_eq!(GetKeyboardLayout(&mut ctx, 1), 0xe0010804);
+        for (key, control, shift, result, word) in [
+            (13, false, false, 1, 0xa50d),
+            (13, true, false, 1, 0xa50a),
+            (13, true, true, 0, 0xa55a),
+            (0xe6, false, false, 1, 0xc0a1),
+            (0x10, false, false, 0, 0xa55a),
+        ] {
+            ctx.memory[0x1000..][..256].fill(0);
+            if control {
+                ctx.memory.write::<u8>(0x1011, 0x80);
+            }
+            if shift {
+                ctx.memory.write::<u8>(0x1010, 0x80);
+            }
+            ctx.memory.write::<u32>(0x2000, 0xdead_a55a);
+            assert_eq!(
+                ToAscii(&mut ctx, key, 0, Ptr::new(0x1000), Ptr::new(0x2000), 0),
+                result
+            );
+            assert_eq!(ctx.memory.read::<u32>(0x2000), 0xdead_0000 | word);
+        }
+        for (mode, code, expected) in [
+            (0, 13, 0x1c),
+            (1, 0x1c, 13),
+            (2, 65, 65),
+            (3, 0xe01d, 0xa2),
+            (4, 0xa3, 0xe01d),
+        ] {
+            assert_eq!(MapVirtualKeyA(&mut ctx, code, mode), expected);
+        }
+    }
+}
