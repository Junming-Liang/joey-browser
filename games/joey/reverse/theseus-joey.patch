diff --git a/win32/winapi/src/kernel32/locale.rs b/win32/winapi/src/kernel32/locale.rs
new file mode 100644
index 0000000..a8cb301
--- /dev/null
+++ b/win32/winapi/src/kernel32/locale.rs
@@ -0,0 +1,111 @@
+//! Installed locale profiles for the original game's browser environment.
+//! This is not the complete Windows locale catalogue or editable user locale.
+use runtime::Context;
+use crate::{Ptr,kernel32::SetLastError};
+#[path = "locale_data.rs"]
+mod data;
+const INSTALLED: &[u32] = &[0x0409,0x0411,0x0804];
+
+#[win32_derive::dllexport]
+pub fn GetUserDefaultLCID(_ctx: &mut Context) -> u32 {0x0804}
+
+#[win32_derive::dllexport]
+pub fn IsValidLocale(_ctx: &mut Context, Locale: u32, dwFlags: u32) -> bool {
+    matches!(dwFlags,1|2) && INSTALLED.contains(&Locale)
+}
+
+#[win32_derive::dllexport]
+pub fn IsValidCodePage(_ctx: &mut Context, CodePage: u32) -> bool {
+    runtime::Memory::code_page_encoding(CodePage).is_some()
+}
+
+#[win32_derive::dllexport]
+pub fn EnumSystemLocalesA(ctx: &mut Context, lpLocaleEnumProc: Ptr<()>, dwFlags: u32) -> bool {
+    if lpLocaleEnumProc.addr == 0 {SetLastError(ctx,87); return false;}
+    if !matches!(dwFlags,0|1|2) {SetLastError(ctx,1004); return false;}
+    let previous = ctx.cpu.regs.esp;
+    ctx.cpu.regs.esp = previous.checked_sub(16).unwrap(); let buffer = ctx.cpu.regs.esp;
+    for locale in INSTALLED {
+        let name = format!("{locale:08x}\0");
+        ctx.memory[buffer..][..name.len()].copy_from_slice(name.as_bytes());
+        let callback = ctx.indirect32(lpLocaleEnumProc.addr);
+        ctx.call32_x86(callback,vec![buffer]);
+        if ctx.cpu.regs.eax == 0 {break;}
+    }
+    ctx.cpu.regs.esp = previous; true
+}
+
+fn info(ctx: &mut Context, Locale: u32, LCType: u32, addr: u32, capacity: i32, wide: bool) -> i32 {
+    if capacity < 0 {SetLastError(ctx,87); return 0;}
+    let locale = if matches!(Locale,0|0x400|0x800) {0x0804} else {Locale};
+    if !INSTALLED.contains(&locale) {SetLastError(ctx,87); return 0;}
+    let kind = LCType & 0xffff;
+    if LCType & !(0xffff|0x20000000|0x40000000|0x80000000) != 0 {SetLastError(ctx,1004); return 0;}
+    let number = LCType & 0x20000000 != 0;
+    let mode = if number {if wide {3} else {4}} else if wide {0} else if LCType & 0x40000000 != 0 {2} else {1};
+    let result = data::lookup(locale,kind,mode).unwrap_or_else(||
+        panic!("Unprobed original locale field: LCID={locale:x} LCTYPE={kind:x}"));
+    let bytes = match result {Ok(bytes)=>bytes,Err(error)=>{SetLastError(ctx,error);return 0;}};
+    let count = (bytes.len()/if wide {2} else {1}) as i32;
+    if capacity == 0 {return count;}
+    if addr == 0 {SetLastError(ctx,87); return 0;}
+    if capacity < count {SetLastError(ctx,122); return 0;}
+    ctx.memory[addr..][..bytes.len()].copy_from_slice(bytes);
+    count
+}
+
+#[win32_derive::dllexport]
+pub fn GetLocaleInfoA(ctx: &mut Context, Locale: u32, LCType: u32, lpLCData: Ptr<u8>, cchData: i32) -> i32 {
+    info(ctx,Locale,LCType,lpLCData.addr,cchData,false)
+}
+#[win32_derive::dllexport]
+pub fn GetLocaleInfoW(ctx: &mut Context, Locale: u32, LCType: u32, lpLCData: Ptr<u16>, cchData: i32) -> i32 {
+    info(ctx,Locale,LCType,lpLCData.addr,cchData,true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn locale_ansi_unicode_and_numeric_sizes_differ() {
+        let mut ctx = Context {cpu:Default::default(),thread_handle:1,thread_id:1,
+            memory:runtime::Memory::leak_new(16384),blocks:&[],cache:Default::default(),recent:[Context::return_from_x86;4]};
+        ctx.cpu.regs.fs_base=0x3000;
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x411,0x1004,Ptr::new(0),0),4);
+        assert_eq!(GetLocaleInfoA(&mut ctx,0,1,Ptr::new(0x1200),5),5);
+        assert_eq!(ctx.memory.read_str(0x1200),"0804");
+        assert_eq!(GetLocaleInfoW(&mut ctx,0x411,0x1004,Ptr::new(0x1000),4),4);
+        assert_eq!(ctx.memory.read_wstr(0x1000).to_string_lossy(),"932");
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x411,0x20000001,Ptr::new(0x1100),4),4);
+        assert_eq!(ctx.memory.read::<u32>(0x1100),0x411);
+        assert_eq!(GetLocaleInfoW(&mut ctx,0x411,0x20000001,Ptr::new(0x1100),2),2);
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x411,0x20001001,Ptr::new(0x1100),4),0);
+        assert_eq!(crate::kernel32::GetLastError(&mut ctx),1004);
+    }
+    #[test]
+    fn reference_currency_encoding_and_binary_fields_are_preserved() {
+        let mut ctx = Context {cpu:Default::default(),thread_handle:1,thread_id:1,
+            memory:runtime::Memory::leak_new(16384),blocks:&[],cache:Default::default(),recent:[Context::return_from_x86;4]};
+        ctx.cpu.regs.fs_base=0x3000;
+        assert_eq!(GetLocaleInfoW(&mut ctx,0x411,0x14,Ptr::new(0x1000),2),2);
+        assert_eq!(ctx.memory.read::<u16>(0x1000),0x00a5);
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x411,0x14,Ptr::new(0x1100),2),2);
+        assert_eq!(ctx.memory.read::<u16>(0x1100),0x005c);
+        let acp = data::lookup(0x411,0x14,2).unwrap().unwrap();
+        assert_ne!(acp,&[0x5c,0]);
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x411,0x40000014,Ptr::new(0x1200),acp.len() as i32),acp.len() as i32);
+        assert_eq!(&ctx.memory[0x1200..][..acp.len()],acp);
+        assert_eq!(GetLocaleInfoW(&mut ctx,0x411,0x15,Ptr::new(0x1300),4),4);
+        assert_eq!(ctx.memory.read_wstr(0x1300).to_string_lossy(),"JPY");
+        assert_eq!(GetLocaleInfoW(&mut ctx,0x804,0x58,Ptr::new(0x1400),16),16);
+        let wide_signature = ctx.memory[0x1400..][..32].to_vec();
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x804,0x58,Ptr::new(0x1500),32),32);
+        assert_eq!(&ctx.memory[0x1500..][..32],wide_signature);
+        ctx.memory.write::<u32>(0x1600,0xdeadbeef);
+        assert_eq!(GetLocaleInfoW(&mut ctx,0x411,0x15,Ptr::new(0x1600),3),0);
+        assert_eq!(crate::kernel32::GetLastError(&mut ctx),122);
+        assert_eq!(ctx.memory.read::<u32>(0x1600),0xdeadbeef);
+        assert_eq!(GetLocaleInfoA(&mut ctx,0x411,0x79,Ptr::new(0x1600),32),0);
+        assert_eq!(crate::kernel32::GetLastError(&mut ctx),1004);
+    }
+}
