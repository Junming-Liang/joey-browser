+#[derive(Clone)]
+struct Value { kind: u32, bytes: Vec<u8> }
+
+#[derive(Default)]
+struct Registry { keys: BTreeMap<String, BTreeMap<String, Value>>, handles: HashMap<u32, String>, next: u32 }
+
+impl Registry {
+    fn path(&self, key: HKEY, subkey: &str) -> Option<String> {
+        let root = match key {
+            0x80000000 => "hkcr",
+            0x80000001 => "hkcu",
+            0x80000002 => "hklm",
+            0x80000003 => "hku",
+            0x80000005 => "hkcc",
+            _ => self.handles.get(&key)?,
+        };
+        Some(if subkey.is_empty() { root.to_owned() } else { format!("{root}\\{}", subkey.trim_matches('\\').to_ascii_lowercase()) })
+    }
+    fn handle(&mut self, path: String) -> HKEY {
+        self.next += 1;
+        let handle = 0x20000 + self.next;
+        self.handles.insert(handle, path); handle
+    }
+    fn create(&mut self, path: &str) -> bool {
+        let new = !self.keys.contains_key(path);
+        let mut part = String::new();
+        for name in path.split('\\') {
+            if !part.is_empty() { part.push('\\'); }
+            part.push_str(name); self.keys.entry(part.clone()).or_default();
+        }
+        new
+    }
+}
+
+static REGISTRY: LazyLock<Mutex<Registry>> = LazyLock::new(|| Mutex::new(Registry::default()));
