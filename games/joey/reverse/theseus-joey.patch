+    fn registry_reopen_and_small_query_buffer_preserve_value() {
+        let mut ctx = Context { cpu: Default::default(), thread_handle: 1, thread_id: 1,
+            memory: runtime::Memory::leak_new(16384), blocks: &[], cache: Default::default(),
+            recent: [Context::return_from_x86; 4] };
