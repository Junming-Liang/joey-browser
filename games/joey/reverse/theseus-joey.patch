+pub fn RegSetValueExA(ctx: &mut Context, hKey: HKEY, lpValueName: u32, Reserved: u32,
+    dwType: u32, lpData: u32, cbData: u32) -> u32 {
+    if Reserved != 0 || (lpData == 0 && cbData != 0) { return ERROR_INVALID_PARAMETER; }
