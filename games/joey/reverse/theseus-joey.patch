+/// Configure the virtual process before its original CRT entry runs.
+/// The diagnostic game's executable name and switches are ASCII.
+pub fn set_command_line(ctx: &mut Context, line: &str) {
+    assert!(line.is_ascii() && !line.as_bytes().contains(&0) && line.len()<32767);
+    let mut state = lock();
+    let len = line.len()+1;
+    let narrow = state.process_heap.alloc(&mut ctx.memory,len as u32);
+    ctx.memory[narrow..][..line.len()].copy_from_slice(line.as_bytes());
+    ctx.memory.write::<u8>(narrow+line.len() as u32,0);
+    let wide = state.process_heap.alloc(&mut ctx.memory,(len*2) as u32);
+    for (i,word) in line.encode_utf16().chain([0]).enumerate() {ctx.memory.write::<u16>(wide+i as u32*2,word);}
+    state.command_line = CommandLine {command_line_8:narrow,command_line_16:wide};
+    let peb = teb(ctx).Peb;
+    let params = ctx.memory.read::<u32>(peb+std::mem::offset_of!(PEB,ProcessParameters) as u32);
+    let command = params+std::mem::offset_of!(RTL_USER_PROCESS_PARAMETERS,CommandLine) as u32;
+    ctx.memory.write::<u16>(command,(line.len()*2) as u16);
+    ctx.memory.write::<u16>(command+2,(len*2) as u16);
+    ctx.memory.write::<u32>(command+4,wide);
+}
+
+#[cfg(test)]
