+fn native_to_rgba(pixels:&[u8],bpp:u32,palette:Option<&[PALETTEENTRY]>) -> Option<Vec<u8>> {
+    let mut out=Vec::with_capacity(pixels.len()/bpp as usize*4);
+    match bpp {
+        1 => for &index in pixels {let color=palette?.get(index as usize)?;out.extend_from_slice(&[color.peRed,color.peGreen,color.peBlue,255]);},
