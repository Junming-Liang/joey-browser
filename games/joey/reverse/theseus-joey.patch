+fn from_file_time(ticks: u64) -> Option<[u16; 8]> {
+    if ticks >= 1 << 63 { return None; }
+    let milliseconds = ticks / 10_000;
+    let days = milliseconds / 86_400_000;
+    let mut remaining = days % 146_097;
+    let mut year = 1601 + days / 146_097 * 400;
+    let leap = |year: u64| year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    loop {
+        let length = if leap(year) { 366 } else { 365 };
+        if remaining < length { break; }
+        remaining -= length; year += 1;
+    }
+    let lengths = [31, if leap(year) {29} else {28}, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+    let mut month = 0;
+    while remaining >= lengths[month] { remaining -= lengths[month]; month += 1; }
+    let day_ms = milliseconds % 86_400_000;
+    Some([year as u16, (month + 1) as u16, ((days + 1) % 7) as u16,
+        (remaining + 1) as u16, (day_ms / 3_600_000) as u16,
+        (day_ms / 60_000 % 60) as u16, (day_ms / 1_000 % 60) as u16,
+        (day_ms % 1_000) as u16])
+}
