diff --git a/win32/winapi/src/kernel32/locale_data.rs b/win32/winapi/src/kernel32/locale_data.rs
new file mode 100644
index 0000000..58a1ed3
--- /dev/null
+++ b/win32/winapi/src/kernel32/locale_data.rs
@@ -0,0 +1,27 @@
+//! Byte-preserving snapshot of canonical reference locale values.
+//! Generated by games/joey/reverse/generate_locale_data.py, not a complete NLS DB.
+const BYTES: &[u8] = include_bytes!("locale_data.bin");
+fn u16_at(at: usize) -> u16 {u16::from_le_bytes(BYTES[at..at+2].try_into().unwrap())}
+fn u32_at(at: usize) -> u32 {u32::from_le_bytes(BYTES[at..at+4].try_into().unwrap())}
+
+pub(super) fn lookup(locale: u32, kind: u32, mode: usize) -> Option<Result<&'static [u8], u32>> {
+    assert!(mode < 5 && &BYTES[..4] == b"JLC1");
+    let key = locale.checked_shl(16)? | kind;
+    let (mut left, mut right) = (0, u32_at(4) as usize);
+    while left < right {
+        let mid = left + (right-left)/2;
+        let at = 8 + mid*44;
+        match key.cmp(&u32_at(at)) {
+            std::cmp::Ordering::Less => right = mid,
+            std::cmp::Ordering::Greater => left = mid+1,
+            std::cmp::Ordering::Equal => {
+                let row = at+4+mode*8;
+                let error = u16_at(row+6) as u32;
+                if error != 0 {return Some(Err(error));}
+                let offset = u32_at(row) as usize;
+                return Some(Ok(&BYTES[offset..offset+u16_at(row+4) as usize]));
+            }
+        }
+    }
+    None
+}
diff --git a/win32/winapi/src/kernel32/sync.rs b/win32/winapi/src/kernel32/sync.rs
new file mode 100644
index 0000000..93ceb79
--- /dev/null
+++ b/win32/winapi/src/kernel32/sync.rs
@@ -0,0 +1,134 @@
+//! Recursive, thread-owned Win32 critical sections. The guest object is opaque.
+//! WASM worker creation is not supported yet; contention must not become a no-op.
+use std::sync::{Arc, Condvar, Mutex, atomic::{AtomicI32, Ordering}};
+use runtime::Context;
+use crate::{Ptr, kernel32::lock};
+
+#[derive(Default)]
+struct Ownership { thread: u32, depth: u32 }
+
+#[derive(Default)]
+pub struct CriticalSection { owner: Mutex<Ownership>, released: Condvar }
+
+impl CriticalSection {
+    fn enter(&self, thread: u32) {
+        assert_ne!(thread, 0);
+        let mut owner = self.owner.lock().unwrap();
+        while owner.thread != 0 && owner.thread != thread {
+            owner = self.released.wait(owner).unwrap();
+        }
+        owner.thread = thread;
+        owner.depth = owner.depth.checked_add(1).expect("critical section recursion overflow");
+    }
+    fn leave(&self, thread: u32) {
+        let mut owner = self.owner.lock().unwrap();
+        assert_eq!(owner.thread, thread, "critical section released by non-owner");
+        assert_ne!(owner.depth, 0);
+        owner.depth -= 1;
+        if owner.depth == 0 { owner.thread = 0; self.released.notify_one(); }
+    }
+}
+
+fn section(addr: u32) -> Arc<CriticalSection> {
+    lock().critical_sections.get(&addr).expect("uninitialized critical section").clone()
+}
+
+#[win32_derive::dllexport]
+pub fn InitializeCriticalSection(ctx: &mut Context, lpCriticalSection: Ptr<()>) {
+    assert!(lpCriticalSection.addr >= 0x1000);
+    let mut state = lock();
+    assert!(!state.critical_sections.contains_key(&lpCriticalSection.addr), "critical section initialized twice");
+    // 32-bit RTL_CRITICAL_SECTION is 24 bytes; applications must not inspect it.
+    ctx.memory[lpCriticalSection.addr..][..24].fill(0);
+    ctx.memory.write::<i32>(lpCriticalSection.addr + 4, -1);
+    state.critical_sections.insert(lpCriticalSection.addr, Arc::new(CriticalSection::default()));
+}
+
+#[win32_derive::dllexport]
+pub fn EnterCriticalSection(ctx: &mut Context, lpCriticalSection: Ptr<()>) {
+    section(lpCriticalSection.addr).enter(ctx.thread_id);
+}
+
+#[win32_derive::dllexport]
+pub fn LeaveCriticalSection(ctx: &mut Context, lpCriticalSection: Ptr<()>) {
+    section(lpCriticalSection.addr).leave(ctx.thread_id);
+}
+
+#[win32_derive::dllexport]
+pub fn DeleteCriticalSection(_ctx: &mut Context, lpCriticalSection: Ptr<()>) {
+    let mut state = lock();
+    let section = state.critical_sections.get(&lpCriticalSection.addr).expect("uninitialized critical section");
+    assert_eq!(section.owner.lock().unwrap().depth, 0, "deleting owned critical section");
+    state.critical_sections.remove(&lpCriticalSection.addr);
+}
+
+fn atomic_long(ctx: &mut Context, addr: u32) -> &AtomicI32 {
+    assert!(addr >= 0x1000 && addr % 4 == 0, "invalid interlocked LONG address");
+    let bytes = &mut ctx.memory.bytes[addr as usize..][..4];
+    let ptr = bytes.as_mut_ptr().cast::<i32>();
+    assert_eq!(ptr.align_offset(std::mem::align_of::<AtomicI32>()), 0);
+    // Guest interlocked addresses use only atomic access during this operation.
+    unsafe { AtomicI32::from_ptr(ptr) }
+}
+
+#[win32_derive::dllexport]
+pub fn InterlockedExchange(ctx: &mut Context, Target: Ptr<i32>, Value: i32) -> i32 {
+    atomic_long(ctx, Target.addr).swap(Value, Ordering::SeqCst)
+}
+
+#[win32_derive::dllexport]
+pub fn InterlockedIncrement(ctx: &mut Context, Addend: Ptr<i32>) -> i32 {
+    atomic_long(ctx, Addend.addr).fetch_add(1, Ordering::SeqCst).wrapping_add(1)
+}
+
+#[win32_derive::dllexport]
+pub fn InterlockedDecrement(ctx: &mut Context, Addend: Ptr<i32>) -> i32 {
+    atomic_long(ctx, Addend.addr).fetch_sub(1, Ordering::SeqCst).wrapping_sub(1)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn interlocked_returns_previous_exchange_and_new_wrapping_arithmetic() {
+        let mut ctx = Context { cpu: Default::default(), thread_handle: 1, thread_id: 1,
+            memory: runtime::Memory::leak_new(8192), blocks: &[], cache: Default::default(),
+            recent: [Context::return_from_x86; 4] };
+        ctx.memory.write::<i32>(0x1000, i32::MAX);
+        assert_eq!(InterlockedIncrement(&mut ctx, Ptr::new(0x1000)), i32::MIN);
+        assert_eq!(InterlockedDecrement(&mut ctx, Ptr::new(0x1000)), i32::MAX);
+        assert_eq!(InterlockedExchange(&mut ctx, Ptr::new(0x1000), -7), i32::MAX);
+        assert_eq!(ctx.memory.read::<i32>(0x1000), -7);
+    }
+    #[test]
+    fn recursive_release_retains_ownership_until_last_leave() {
+        let section = CriticalSection::default();
+        section.enter(1); section.enter(1); section.leave(1);
+        let owner = section.owner.lock().unwrap();
+        assert_eq!((owner.thread, owner.depth), (1, 1)); drop(owner);
+        section.leave(1);
+        let owner = section.owner.lock().unwrap(); assert_eq!((owner.thread, owner.depth), (0, 0));
+    }
+    #[test]
+    fn competing_threads_cannot_overlap() {
+        let section = Arc::new(CriticalSection::default());
+        let value = Arc::new(std::sync::atomic::AtomicU32::new(0));
+        let threads: Vec<_> = (1..=4).map(|id| {
+            let section = section.clone(); let value = value.clone();
+            std::thread::spawn(move || {
+                for _ in 0..500 {
+                    section.enter(id); section.enter(id);
+                    let old = value.load(std::sync::atomic::Ordering::Relaxed);
+                    std::thread::yield_now();
+                    value.store(old + 1, std::sync::atomic::Ordering::Relaxed);
+                    section.leave(id); section.leave(id);
+                }
+            })
+        }).collect();
+        for thread in threads { thread.join().unwrap(); }
+        assert_eq!(value.load(std::sync::atomic::Ordering::Relaxed), 2000);
+    }
+    #[test]
+    #[should_panic(expected = "critical section released by non-owner")]
+    fn non_owner_cannot_release() { let section = CriticalSection::default(); section.enter(1); section.leave(2); }
+}
