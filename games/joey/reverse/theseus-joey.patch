+
+fn mul_div(number: i32, numerator: i32, denominator: i32) -> i32 {
+    if denominator == 0 {
+        return -1;
+    }
+    assert_ne!(denominator, i32::MIN, "MulDiv INT_MIN divisor unverified");
+    let product = number as i64 * numerator as i64;
+    let divisor = (denominator as i64).unsigned_abs();
+    let magnitude = (product.unsigned_abs() + divisor / 2) / divisor;
+    assert_ne!(magnitude, 1u64 << 31, "MulDiv 2^31 quotient unverified");
+    if magnitude > i32::MAX as u64 {
+        return -1;
+    }
+    if (product < 0) ^ (denominator < 0) {
+        -(magnitude as i32)
+    } else {
+        magnitude as i32
+    }
+}
