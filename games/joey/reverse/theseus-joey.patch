+        let kinds=[1,1,1,3,2,7,1,1];let sizes=[3,3,4,3,3,3,0,3];let capacities=[8,8,8,8,8,8,8,2];
+        for line in include_str!("registry_reference.txt").lines() {
+            let v=line.split_whitespace().skip(1).map(|s|u32::from_str_radix(s,16).unwrap()).collect::<Vec<_>>();let i=v[0] as usize;
+            ctx.memory[0x1300..][..inputs[i].len()].copy_from_slice(inputs[i]);ctx.memory[0x1400..][..8].fill(0xaa);
+            ctx.memory.write::<u32>(0x1208,0xaa);ctx.memory.write::<u32>(0x120c,capacities[i]);
+            assert_eq!(RegSetValueExA(&mut ctx,key,0x1100,0,kinds[i],0x1300,sizes[i]),v[1],"set {i}");
+            assert_eq!(RegQueryValueExA(&mut ctx,key,0x1100,0,0x1208,0x1400,0x120c),v[2],"query {i}");
+            assert_eq!(ctx.memory.read::<u32>(0x1208),v[3],"type {i}");assert_eq!(ctx.memory.read::<u32>(0x120c),v[4],"length {i}");
+            assert_eq!(&ctx.memory[0x1400..][..8],v[5..].iter().map(|b|*b as u8).collect::<Vec<_>>().as_slice(),"sentinels {i}");
+        }
