+pub fn timeEndPeriod(_ctx: &mut Context, uPeriod: u32) -> u32 {
+    if !(TIMER_MIN..=TIMER_MAX).contains(&uPeriod) { return TIMERR_NOCANDO; }
+    let mut state = state();
+    let Some(count) = state.period_requests.get_mut(&uPeriod) else { return TIMERR_NOCANDO; };
+    *count -= 1;
+    if *count == 0 { state.period_requests.remove(&uPeriod); }
+    0
+}
+
 pub struct Timer {
     pub period: u32,
     pub next: u32,
