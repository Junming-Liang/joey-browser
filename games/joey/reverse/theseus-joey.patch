+// only the game's key from the browser's own profile, never a host registry.
+const PROFILE_KEY_FILE: &str = "/joey-profile-key.bin";
+fn is_profile_key(path: &str, name: &str) -> bool {
+    name == "flcrc" && path.ends_with("\\software\\konami\\yu-gi-oh! power of chaos\\system")
+}
 
