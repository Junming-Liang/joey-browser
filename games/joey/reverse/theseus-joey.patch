+        ctx.memory.write::<u32>(0x1210, 2); ctx.memory.write::<u32>(0x1220, 0xdeadbeef);
+        assert_eq!(RegQueryValueExA(&mut ctx, reopened, 0x1100, 0, 0x1208, 0x1220, 0x1210), ERROR_MORE_DATA);
+        assert_eq!(ctx.memory.read::<u32>(0x1210), 4);
+        assert_eq!(ctx.memory.read::<u32>(0x1220), 0xdeadbeef);
+        assert_eq!(RegQueryValueExA(&mut ctx, reopened, 0x1100, 0, 0x1208, 0x1220, 0x1210), 0);
+        assert_eq!(ctx.memory.read::<u32>(0x1208), 4);
+        assert_eq!(ctx.memory.read::<u32>(0x1220), 0x12345678);
+    }
