+        assert_eq!(&DATA[..5], b"JYGF3");
+        let count = u16::from_le_bytes(DATA[5..7].try_into().unwrap()) as usize;
+        let profile_count = u16::from_le_bytes(DATA[7..9].try_into().unwrap()) as usize;
+        let mut offsets = vec![u32::MAX; profile_count*65536].into_boxed_slice();
+        let mut profiles = Vec::new(); let mut cursor = 9;
+        for profile in 0..profile_count {
+            let bits = DATA[cursor+5] as usize; assert!(matches!(bits,1|4));
+            profiles.push(Profile {
+                height: u16::from_le_bytes(DATA[cursor..cursor+2].try_into().unwrap()) as i32,
+                weight: u16::from_le_bytes(DATA[cursor+2..cursor+4].try_into().unwrap()) as i32,
+                quality: DATA[cursor+4] as u32, bits, metrics: cursor+6,
+            });
+            cursor += 66;
+            for _ in 0..count {
+                let ch = u16::from_le_bytes(DATA[cursor..cursor+2].try_into().unwrap());
+                offsets[profile*65536+ch as usize] = cursor as u32;
+                cursor += 10 + (DATA[cursor+8] as usize * DATA[cursor+9] as usize * bits).div_ceil(8);
+            }
+        }
+        assert_eq!(cursor, DATA.len()); Atlas {offsets, profiles}
+    })
+}
+struct Glyph { index: u16, before: i32, after: i32, left: i32, top: i32, width: usize, height: usize, bits: usize, levels: &'static [u8] }
+impl Glyph {
+    fn level(&self, pixel: usize) -> u8 {
+        let code=(self.levels[pixel*self.bits/8] >> (pixel*self.bits%8)) & ((1<<self.bits)-1);
+        if self.bits==1 {code*16} else if code==0 {0} else {code+1}
+    }
+}
+fn glyph(profile: usize, ch: u16) -> Glyph {
+    let offset = atlas().offsets[profile*65536+ch as usize];
+    assert_ne!(offset, u32::MAX, "Uncaptured GDI character U+{ch:04x}");
+    let bytes = &DATA[offset as usize..];
+    let width = bytes[8] as usize; let height = bytes[9] as usize;
+    let bits=atlas().profiles[profile].bits;
+    Glyph { index: u16::from_le_bytes(bytes[2..4].try_into().unwrap()), before: bytes[4] as i32, after: bytes[5] as i32,
+        left: bytes[6] as i8 as i32, top: bytes[7] as i8 as i32, width, height, bits, levels: &bytes[10..10+(width*height*bits).div_ceil(8)] }
+}
+fn cell_height(profile: usize) -> i32 { i32::from_le_bytes(DATA[atlas().profiles[profile].metrics..][..4].try_into().unwrap()) }
+
+#[win32_derive::dllexport]
+pub fn CreateFontA(ctx: &mut Context, height: i32, width: i32, escapement: i32, orientation: i32, weight: i32,
+    italic: u32, underline: u32, strikeout: u32, charset: u32, out_precision: u32, clip_precision: u32,
+    quality: u32, pitch: u32, face: Ptr<u8>) -> HGDIOBJ {
+    let name = if face.addr == 0 { &[][..] } else {ctx.memory.read_cstr(face.addr)};
+    // Native CreateFontA(14,300,2) selection highlight: all 21,887 glyphs,
+    // indices, cold/warm widths and metrics exactly match captured (14,400,2).
+    // Probe SHA256: aa960c3e1f56ec1a1e2293c8850b62dfe22c797bbfb04ca76fe20b9c3f386ed8.
+    let captured_weight=if (height,weight,quality)==(14,300,2) {400} else {weight};
+    let profile=atlas().profiles.iter().position(|p| p.height==height && p.weight==captured_weight && p.quality==quality);
+    assert!(profile.is_some() && width==0 && escapement==0 && orientation==0 &&
+        italic==0 && underline==0 && strikeout==0 && charset==1 && out_precision==0 && clip_precision==0 &&
+        matches!(quality,2|3) && pitch==0 && name==[0xcb,0xce,0xcc,0xe5],
+        "Uncaptured GDI font: height={height} width={width} weight={weight} quality={quality} charset={charset} faceBytes={name:x?} italic={italic} underline={underline} strikeout={strikeout} angles={escapement}/{orientation} precision={out_precision}/{clip_precision} pitch={pitch}");
+    let profile=profile.unwrap();
+    gdi32::lock().objects.add(Object::Font(Font {profile}))
+}
+
+#[win32_derive::dllexport]
+pub fn SetTextColor(_ctx: &mut Context, dc: HDC, color: COLORREF) -> COLORREF {
+    let mut state=gdi32::lock(); let Some(dc)=state.dcs.get_mut(dc) else {return COLORREF::from_win32(u32::MAX)};
+    std::mem::replace(&mut dc.text_color,color)
+}
+#[win32_derive::dllexport]
+pub fn SetBkColor(_ctx: &mut Context, dc: HDC, color: COLORREF) -> COLORREF {
+    let mut state=gdi32::lock(); let Some(dc)=state.dcs.get_mut(dc) else {return COLORREF::from_win32(u32::MAX)};
+    std::mem::replace(&mut dc.background_color,color)
+}
+#[win32_derive::dllexport]
+pub fn SetBkMode(_ctx: &mut Context, dc: HDC, mode: i32) -> i32 {
+    if !matches!(mode,1|2) {return 0;}
+    let mut state=gdi32::lock(); let Some(dc)=state.dcs.get_mut(dc) else {return 0};
+    std::mem::replace(&mut dc.background_mode,mode)
+}
+fn text(ctx: &Context, ptr: Ptr<u16>, count: i32) -> Option<Vec<u16>> {
+    if count<0 || (count>0 && ptr.addr==0) {return None;}
+    let length=(count as usize).checked_mul(2)?;
+    let bytes=ctx.memory.bytes.get(ptr.addr as usize..(ptr.addr as usize).checked_add(length)?)?;
+    Some(bytes.chunks_exact(2).map(|b|u16::from_le_bytes(b.try_into().unwrap())).collect())
+}
+fn extent(state: &gdi32::State, profile: usize, text: &[u16]) -> i32 {
+    text.iter().map(|&ch| {let g=glyph(profile,ch); if state.drawn_glyphs.contains(&(profile,g.index)) {g.after} else {g.before}}).sum()
+}
+#[win32_derive::dllexport]
+pub fn GetTextExtentPoint32W(ctx: &mut Context, dc: HDC, string: Ptr<u16>, count: i32, size: Ptr<i32>) -> bool {
+    let Some(text)=text(ctx,string,count) else {return false};
+    if size.addr==0 {return false;}
+    let state=gdi32::lock(); let Some(dc)=state.dcs.get(dc) else {return false};
+    let profile=dc.font.1.expect("Default GDI font rendering not captured").profile;
+    ctx.memory.write::<i32>(size.addr,extent(&state,profile,&text));
+    ctx.memory.write::<i32>(size.addr+4,if count==0 {0} else {cell_height(profile)}); true
+}
+fn blend(background: u8, foreground: u8, level: u8) -> u8 {
+    if level<=1 || background==foreground {return background;}
+    if level>=16 {return foreground;}
+    let b=background as u32;let f=foreground as u32;
+    let low=RAMP[level as usize]*f/255;
+    let high=RAMP[16-level as usize]+(255-RAMP[16-level as usize])*f/255;
+    if b>f {(f+(b-f)*(high-f)/(255-f)) as u8} else {(f-(f-b)*(f-low)/f) as u8}
+}
+fn paint(bitmap: &gdi32::Bitmap, pixels: &mut [u8], x: i32, y: i32, color: [u8;3], level: u8) {
+    if x<0 || y<0 || x>=bitmap.width as i32 || y>=bitmap.height as i32 || level<=1 {return;}
+    let row=if bitmap.is_bottom_up {bitmap.height-1-y as u32} else {y as u32};
+    let offset=row as usize*bitmap.stride() as usize+x as usize*(bitmap.bit_count as usize/8);
+    let color=if bitmap.is_bgr {[color[2],color[1],color[0]]} else {color};
+    for channel in 0..3 {pixels[offset+channel]=blend(pixels[offset+channel],color[channel],level);}
+    // Native DIB padding byte is retained. Host RGBA surfaces require opaque alpha.
+    if bitmap.bit_count==32 && !bitmap.is_bgr {pixels[offset+3]=255;}
+}
+#[win32_derive::dllexport]
+pub fn TextOutW(ctx: &mut Context, dc: HDC, x: i32, y: i32, string: Ptr<u16>, count: i32) -> bool {
+    let Some(text)=text(ctx,string,count) else {return false};
+    let mut state=gdi32::lock(); let Some(dc)=state.dcs.get(dc) else {return false};
+    let profile=dc.font.1.expect("Default GDI font rendering not captured").profile;
+    let bitmap=dc.bitmap.1.clone();let foreground=dc.text_color.to_rgb();let background=dc.background_color.to_rgb();
+    let opaque=dc.background_mode==2;let width=extent(&state,profile,&text);
+    assert!(matches!(bitmap.bit_count,24|32), "Uncaptured text bitmap depth {}",bitmap.bit_count);
+    let pixels=bitmap.pixels_mut(&mut ctx.memory);
+    if opaque {for yy in y.max(0)..(y+cell_height(profile)).min(bitmap.height as i32) {
+        for xx in x.max(0)..(x+width).min(bitmap.width as i32) {paint(&bitmap,pixels,xx,yy,background,16);}
+    }}
+    let mut cursor=x;
+    for ch in text {
+        let g=glyph(profile,ch);
+        for yy in 0..g.height {for xx in 0..g.width {
+            paint(&bitmap,pixels,cursor+g.left+xx as i32,y+g.top+yy as i32,foreground,g.level(yy*g.width+xx));
+        }}
+        cursor+=g.after;
+        state.drawn_glyphs.insert((profile,g.index));
+    }
+    true
+}
