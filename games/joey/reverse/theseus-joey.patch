+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn unhex(s: &str) -> Vec<u8> {(0..s.len()).step_by(2).map(|i|u8::from_str_radix(&s[i..i+2],16).unwrap()).collect()}
+    fn number(s: &str) -> i32 {u32::from_str_radix(s,16).unwrap() as i32}
+    #[test]
+    fn actual_font_apis_match_native_cold_warm_color_background_and_clipping() {
+        let mut ctx=Context {cpu: Default::default(),thread_handle:1,thread_id:1,
+            memory:runtime::Memory::leak_new(65536),blocks:&[],cache:Default::default(),recent:[Context::return_from_x86;4]};
+        ctx.memory[0xa000..][..5].copy_from_slice(&[0xcb,0xce,0xcc,0xe5,0]);
+        let mut bitmap=gdi32::Bitmap::new_simple(192,32,0x1000);bitmap.is_bgr=true;
+        let dc=gdi32::lock().new_memory_dc(bitmap);
+        let samples=["AVWa 1234","攻/1234 守/2345","发动魔法卡","生还的宝札"];
+        let mut font=HGDIOBJ::null();let mut previous=HGDIOBJ::null();let mut checked=0;
+        for record in include_str!("font_reference.txt").lines() {
+            let v=record.split_whitespace().collect::<Vec<_>>();
+            if v[0]=="A" {assert_eq!(number(v[1]),936);continue;}
+            if v[0]=="F" {
+                if !font.is_null() {assert_eq!(gdi32::SelectObject(&mut ctx,dc,previous),font);assert!(gdi32::DeleteObject(&mut ctx,font));}
+                gdi32::lock().drawn_glyphs.clear();
+                font=CreateFontA(&mut ctx,number(v[2]),0,0,0,number(v[5]),0,0,0,1,0,0,number(v[3]) as u32,0,Ptr::new(0xa000));
+                previous=gdi32::SelectObject(&mut ctx,dc,font);assert_eq!(previous,DEFAULT_FONT);
+                assert!(!gdi32::DeleteObject(&mut ctx,font));continue;
+            }
+            if v[0]=="Z" {
+                assert_eq!(GetTextExtentPoint32W(&mut ctx,dc,Ptr::new(0x9000),0,Ptr::new(0x9100)),number(v[2])!=0);
+                assert_eq!(ctx.memory.read::<i32>(0x9100),number(v[3]));assert_eq!(ctx.memory.read::<i32>(0x9104),number(v[4]));continue;
+            }
+            let (text,colors,mode,x,y,before_w,before_h,after_w,after_h,image,width)=match v[0] {
+                "G" => (vec![number(v[2]) as u16],false,1,4,4,number(v[4]),number(v[5]),number(v[8]),number(v[9]),v[10],32),
+                "C" => (samples[number(v[2]) as usize].encode_utf16().collect(),number(v[3])!=0,1,4,4,number(v[5]),number(v[6]),number(v[9]),number(v[10]),v[11],192),
+                "T" => (samples[number(v[2]) as usize].encode_utf16().collect(),number(v[3])!=0,1,4,4,number(v[5]),number(v[6]),number(v[5]),number(v[6]),v[8],192),
+                "B" => (samples[number(v[2]) as usize].encode_utf16().collect(),number(v[3])!=0,number(v[4]),number(v[5]),number(v[6]),number(v[8]),number(v[9]),number(v[12]),number(v[13]),v[14],192),
+                _=>panic!("Unknown native row"),
+            };
+            for (i,&ch) in text.iter().enumerate() {ctx.memory.write::<u16>(0x9000+i as u32*2,ch);}
+            let fg=if colors {0x563412} else {0xffffff};let bg=if colors {0xd7b593} else {0};
+            let initial=if v[0]=="B" {COLORREF::from_win32(0x537da1)} else {COLORREF::from_win32(bg)};
+            let rgb=initial.to_rgb();let pixel=[rgb[2],rgb[1],rgb[0],0];
+            for chunk in ctx.memory[0x1000..][..192*32*4].chunks_exact_mut(4) {chunk.copy_from_slice(&pixel);}
+            assert_ne!(SetBkMode(&mut ctx,dc,mode),0);SetTextColor(&mut ctx,dc,COLORREF::from_win32(fg));SetBkColor(&mut ctx,dc,COLORREF::from_win32(bg));
+            assert!(GetTextExtentPoint32W(&mut ctx,dc,Ptr::new(0x9000),text.len() as i32,Ptr::new(0x9100)));
+            assert_eq!(ctx.memory.read::<i32>(0x9100),before_w,"before {checked}");assert_eq!(ctx.memory.read::<i32>(0x9104),before_h);
+            assert!(TextOutW(&mut ctx,dc,x,y,Ptr::new(0x9000),text.len() as i32));
+            assert!(GetTextExtentPoint32W(&mut ctx,dc,Ptr::new(0x9000),text.len() as i32,Ptr::new(0x9100)));
+            assert_eq!(ctx.memory.read::<i32>(0x9100),after_w,"after {checked}");assert_eq!(ctx.memory.read::<i32>(0x9104),after_h);
+            let expected=unhex(image);let mut actual=Vec::new();
+            assert_eq!(expected.len(),32*width*3);
+            for yy in 0..32 {for xx in 0..width {let offset=0x1000+((yy*192+xx)*4) as u32;actual.extend_from_slice(&ctx.memory[offset..][..3]);}}
+            assert_eq!(actual.len(),expected.len());
+            assert!(actual==expected,"native pixels row {checked}: {} differing bytes",actual.iter().zip(&expected).filter(|(a,b)|a!=b).count());checked+=1;
+        }
+        assert_eq!(checked,1620); // Twelve profiles: glyphs, cold/warm strings, background and clipping.
+        gdi32::SelectObject(&mut ctx,dc,previous);assert!(gdi32::DeleteObject(&mut ctx,font));assert!(gdi32::DeleteDC(&mut ctx,dc));
+    }
+}
