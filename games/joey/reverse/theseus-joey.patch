index 0000000..a12cca0
--- /dev/null
+++ b/win32/winapi/src/ddraw/clipper.rs
@@ -0,0 +1,150 @@
+//! DirectDraw window clipping, with actual COM ownership and guest RGNDATA ABI.
+use runtime::Context;
+use crate::{RECT,kernel32,user32::{self,HWND},ddraw::{state,GUID,DD}};
+
+pub const IID_IDirectDrawClipper: GUID = GUID((0x6c14db85,0xa733,0x11ce,[0xa5,0x21,0,0x20,0xaf,0x0b,0xe5,0x60]));
+pub struct Clipper {
+    refs:u32, hwnd:Option<HWND>, regions:Option<Vec<RECT>>, changed:bool,
+    last_reported:Option<Vec<RECT>>,
+}
+impl Clipper {
+    pub fn regions(&self) -> Result<Vec<RECT>,DD> {
+        if let Some(hwnd)=self.hwnd {
+            let window=user32::state().window.borrow();
+            let Some(window)=window.as_ref() else {return Err(DD::ERR_NOHWND);};
+            let window=window.borrow();
+            if hwnd!=window.hwnd {return Err(DD::ERR_NOHWND);}
+            let rect=RECT {left:window.x+window.frame.left,top:window.y+window.frame.top,
+                right:window.x+window.frame.left+window.width as i32,bottom:window.y+window.frame.top+window.height as i32}.clip_to_size(1024,768);
+            return Ok(if rect.right>rect.left&&rect.bottom>rect.top {vec![rect]}else {vec![]});
+        }
+        self.regions.clone().ok_or(DD::ERR_NOCLIPLIST)
+    }
+}
+
+pub fn create_clipper(ctx:&mut Context,flags:u32,output:u32,outer:u32) -> DD {
+    if output==0||flags!=0 {return DD::ERR_INVALIDPARAMS;}
+    ctx.memory.write::<u32>(output,0);
+    if outer!=0 {return DD::E_NOAGGREGATION;}
+    let addr=kernel32::lock().process_heap.alloc(&mut ctx.memory,4);
+    ctx.memory.write::<u32>(addr,unsafe {IDirectDrawClipper::VTABLE});
+    state().clippers.borrow_mut().insert(addr,Clipper {refs:1,hwnd:None,regions:None,changed:false,last_reported:None});
+    ctx.memory.write::<u32>(output,addr);DD::OK
+}
+
+pub mod IDirectDrawClipper {
+    use super::*;
+    pub const VTABLE_ENTRIES:[&str;9]=["QueryInterface","AddRef","Release","GetClipList","GetHWnd","Initialize","IsClipListChanged","SetClipList","SetHWnd"];
+    pub static mut VTABLE:u32=0;
+    #[win32_derive::dllexport]
+    pub fn QueryInterface(ctx:&mut Context,this:u32,riid:u32,output:u32)->DD {
+        if riid==0||output==0 {return DD::ERR_INVALIDPARAMS;}
+        ctx.memory.write::<u32>(output,0);
+        let iid=ctx.memory.read::<GUID>(riid);
+        if iid!=IID_IDirectDrawClipper&&iid!=GUID((0,0,0,[0xc0,0,0,0,0,0,0,0x46])) {return DD::E_NOINTERFACE;}
+        if AddRef(ctx,this)==0 {return DD::ERR_INVALIDPARAMS;}
+        ctx.memory.write::<u32>(output,this);DD::OK
+    }
+    #[win32_derive::dllexport]
+    pub fn AddRef(_ctx:&mut Context,this:u32)->u32 {
+        let mut clippers=state().clippers.borrow_mut();
+        let Some(clipper)=clippers.get_mut(&this) else {return 0;};
+        clipper.refs=clipper.refs.checked_add(1).unwrap();clipper.refs
+    }
+    #[win32_derive::dllexport]
+    pub fn Release(ctx:&mut Context,this:u32)->u32 {
+        let mut clippers=state().clippers.borrow_mut();
+        let Some(clipper)=clippers.get_mut(&this) else {return 0;};
+        clipper.refs-=1;let count=clipper.refs;
+        if count==0 {clippers.remove(&this);kernel32::lock().process_heap.free(&mut ctx.memory,this);}
+        count
+    }
+    #[win32_derive::dllexport]
+    pub fn GetClipList(ctx:&mut Context,this:u32,filter:u32,output:u32,size:u32)->DD {
+        if size==0 {return DD::ERR_INVALIDPARAMS;}
+        let mut regions=match state().clippers.borrow().get(&this).unwrap().regions() {Ok(r)=>r,Err(e)=>return e};
+        if filter!=0 {
+            let filter=ctx.memory.read::<RECT>(filter);
+            regions=regions.iter().map(|r|r.clip(&filter)).filter(|r|r.right>r.left&&r.bottom>r.top).collect();
+        }
+        let required=32+regions.len() as u32*16;
+        let available=ctx.memory.read::<u32>(size);ctx.memory.write::<u32>(size,required);
+        if output==0 {return DD::OK;}
+        if available<required {return DD::ERR_REGIONTOOSMALL;}
+        let bounds=regions.iter().copied().reduce(|a,b|RECT {left:a.left.min(b.left),top:a.top.min(b.top),right:a.right.max(b.right),bottom:a.bottom.max(b.bottom)}).unwrap_or_default();
+        for (i,value) in [32,1,regions.len() as u32,regions.len() as u32*16].into_iter().enumerate() {ctx.memory.write::<u32>(output+i as u32*4,value);}
+        ctx.memory.write::<RECT>(output+16,bounds);
+        for (i,rect) in regions.into_iter().enumerate() {ctx.memory.write::<RECT>(output+32+i as u32*16,rect);}
+        DD::OK
+    }
+    #[win32_derive::dllexport]
+    pub fn GetHWnd(ctx:&mut Context,this:u32,output:u32)->DD {
+        if output==0 {return DD::ERR_INVALIDPARAMS;}
+        let clips=state().clippers.borrow();let clip=clips.get(&this).unwrap();
+        ctx.memory.write::<u32>(output,clip.hwnd.map(|h|h.to_raw()).unwrap_or(0));DD::OK
+    }
+    #[win32_derive::dllexport]
+    pub fn Initialize(_ctx:&mut Context,_this:u32,_ddraw:u32,_flags:u32)->DD {DD::ERR_ALREADYINITIALIZED}
+    #[win32_derive::dllexport]
+    pub fn IsClipListChanged(ctx:&mut Context,this:u32,output:u32)->DD {
+        if output==0 {return DD::ERR_INVALIDPARAMS;}
+        let mut clips=state().clippers.borrow_mut();let clip=clips.get_mut(&this).unwrap();
+        let current=clip.regions().ok();let changed=clip.changed||clip.last_reported!=current;
+        clip.last_reported=current;clip.changed=false;ctx.memory.write::<u32>(output,changed as u32);DD::OK
+    }
+    #[win32_derive::dllexport]
+    pub fn SetClipList(ctx:&mut Context,this:u32,input:u32,flags:u32)->DD {
+        if flags!=0 {return DD::ERR_INVALIDPARAMS;}
+        let mut clips=state().clippers.borrow_mut();let clip=clips.get_mut(&this).unwrap();
+        if clip.hwnd.is_some() {return DD::ERR_CLIPPERISUSINGHWND;}
+        let regions=if input==0 {None}else {
+            if ctx.memory.read::<u32>(input)!=32||ctx.memory.read::<u32>(input+4)!=1 {return DD::ERR_INVALIDPARAMS;}
+            let count=ctx.memory.read::<u32>(input+8);let bytes=ctx.memory.read::<u32>(input+12);
+            if count.checked_mul(16)!=Some(bytes)||count>4096 {return DD::ERR_INVALIDPARAMS;}
+            Some((0..count).map(|i|ctx.memory.read::<RECT>(input+32+i*16)).collect())
+        };
+        clip.regions=regions;clip.changed=true;DD::OK
+    }
+    #[win32_derive::dllexport]
+    pub fn SetHWnd(_ctx:&mut Context,this:u32,flags:u32,hwnd:HWND)->DD {
+        if flags!=0 {return DD::ERR_INVALIDPARAMS;}
+        if !hwnd.is_null() {
+            let windows=user32::state().window.borrow();
+            if windows.as_ref().map(|w|w.borrow().hwnd)!=Some(hwnd) {return DD::ERR_INVALIDPARAMS;}
+        }
+        let mut clips=state().clippers.borrow_mut();let clip=clips.get_mut(&this).unwrap();
+        clip.hwnd=hwnd.to_option();clip.changed=true;DD::OK
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn region_buffer_sizing_intersection_and_changed_bool_width() {
+        let mut ctx=Context {cpu:Default::default(),thread_handle:1,thread_id:1,
+            memory:runtime::Memory::leak_new(16384),blocks:&[],cache:Default::default(),recent:[Context::return_from_x86;4]};
+        let this=0x200000;
+        state().clippers.borrow_mut().insert(this,Clipper {refs:1,hwnd:None,changed:true,last_reported:None,
+            regions:Some(vec![RECT {left:100,top:100,right:200,bottom:200},RECT {left:300,top:300,right:400,bottom:400}])});
+        ctx.memory.write::<RECT>(0x1000,RECT {left:150,top:150,right:350,bottom:350});
+        ctx.memory.write::<u32>(0x1100,0);
+        assert_eq!(IDirectDrawClipper::GetClipList(&mut ctx,this,0x1000,0,0x1100),DD::OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1100),64);
+        ctx.memory.write::<u32>(0x1100,32);ctx.memory.write::<u32>(0x1200,0xdeadbeef);
+        assert_eq!(IDirectDrawClipper::GetClipList(&mut ctx,this,0x1000,0x1200,0x1100),DD::ERR_REGIONTOOSMALL);
+        assert_eq!(ctx.memory.read::<u32>(0x1200),0xdeadbeef);
+        assert_eq!(ctx.memory.read::<u32>(0x1100),64);
+        assert_eq!(IDirectDrawClipper::GetClipList(&mut ctx,this,0x1000,0x1200,0x1100),DD::OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1208),2);
+        assert_eq!(ctx.memory.read::<RECT>(0x1210),RECT {left:150,top:150,right:350,bottom:350});
+        assert_eq!(ctx.memory.read::<RECT>(0x1220),RECT {left:150,top:150,right:200,bottom:200});
+        assert_eq!(ctx.memory.read::<RECT>(0x1230),RECT {left:300,top:300,right:350,bottom:350});
+        ctx.memory.write::<u32>(0x1300,u32::MAX);
+        assert_eq!(IDirectDrawClipper::IsClipListChanged(&mut ctx,this,0x1300),DD::OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1300),1);
+        assert_eq!(IDirectDrawClipper::IsClipListChanged(&mut ctx,this,0x1300),DD::OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1300),0);
+        state().clippers.borrow_mut().remove(&this);
+    }
+}
