+            let value=u16::from_le_bytes(bytes.try_into().unwrap());
+            let (r,g,b)=(value>>11,(value>>5)&63,value&31);
+            out.extend_from_slice(&[(r<<3|r>>2) as u8,(g<<2|g>>4) as u8,(b<<3|b>>2) as u8,255]);
+        },
+        4 => for bytes in pixels.chunks_exact(4) {out.extend_from_slice(&[bytes[2],bytes[1],bytes[0],255]);},
+        _ => panic!("Unsupported native DirectDraw pixel size {bpp}"),
