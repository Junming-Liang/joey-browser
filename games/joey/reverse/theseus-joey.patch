diff --git a/runtime/src/diagnostic.rs b/runtime/src/diagnostic.rs
new file mode 100644
index 0000000..04846d2
--- /dev/null
+++ b/runtime/src/diagnostic.rs
@@ -0,0 +1,33 @@
+//! Debug-build execution snapshots for guest memory faults. No raw Context
+//! pointer is retained across calls, and snapshots stay local to each thread.
+use crate::{ContFn, Context};
+use std::cell::Cell;
+
+#[derive(Clone, Copy)]
+struct Snapshot {
+    registers: [u32; 8],
+    blocks: &'static [(u32, ContFn)],
+    recent: [ContFn; 4],
+    current: ContFn,
+}
+thread_local! {static LAST:Cell<Option<Snapshot>>=const {Cell::new(None)};}
+
+pub(crate) fn record(ctx: &Context, current: ContFn) {
+    let r = &ctx.cpu.regs;
+    LAST.set(Some(Snapshot {
+        registers: [r.eax, r.ecx, r.edx, r.ebx, r.esi, r.edi, r.esp, r.ebp],
+        blocks: ctx.blocks,
+        recent: ctx.recent,
+        current,
+    }));
+}
+
+pub(crate) fn report(address: u32) {
+    LAST.with(|last| {
+        if let Some(s)=last.get() {
+            let resolve=|f| s.blocks.iter().find(|(_,block)|std::ptr::fn_addr_eq(*block,f)).map(|(address,_)|*address);
+            let recent=s.recent.map(resolve);
+            log::error!("guest memory fault at {address:08x}: block={:x?} recent={recent:x?} registers[eax ecx edx ebx esi edi esp ebp]={:x?}",resolve(s.current),s.registers);
+        }
+    });
+}
