+// Classic 96-DPI virtual desktop, matching the existing original-game oracle.
+// Insets are positive; the canvas presents the client area only.
+pub(crate) fn window_insets(style: u32, menu: bool) -> RECT {
+    const BORDER: u32 = 0x00800000;
+    const DLGFRAME: u32 = 0x00400000;
+    const THICKFRAME: u32 = 0x00040000;
+    let border = if style & THICKFRAME != 0 { 4 } else if style & DLGFRAME != 0 { 3 } else if style & BORDER != 0 { 1 } else { 0 };
+    let caption = if style & (BORDER | DLGFRAME) == BORDER | DLGFRAME { 19 } else { 0 };
+    RECT { left: border, top: border + caption + if menu { 19 } else { 0 }, right: border, bottom: border }
+}
+
+#[win32_derive::dllexport]
+pub fn AdjustWindowRect(ctx: &mut Context, lpRect: Ptr<RECT>, dwStyle: u32, bMenu: bool) -> bool {
+    let Some(mut rect) = lpRect.read(&ctx.memory) else { return false; };
+    let frame = window_insets(dwStyle, bMenu);
+    rect.left -= frame.left; rect.top -= frame.top;
+    rect.right += frame.right; rect.bottom += frame.bottom;
+    lpRect.write(&mut ctx.memory, rect).is_some()
+}
