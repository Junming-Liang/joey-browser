+    use super::*;
+    #[test]
+    fn ansi_unicode_and_peb_process_parameters_agree() {
+        let mut ctx = Context {cpu:Default::default(),thread_handle:1,thread_id:1,
+            memory:runtime::Memory::leak_new(16384),blocks:&[],cache:Default::default(),recent:[Context::return_from_x86;4]};
+        kernel32::init_state(0x400000,0..0);
+        lock().process_heap=Heap::new(0x2000,0x1000);
+        ctx.cpu.regs.fs_base=0x1000;
+        kernel32::teb_mut(&mut ctx).Peb=0x1800;
+        ctx.memory.write::<u32>(0x1810,0x1900);
+        let line="joey_pc_cn.exe -win -e";
+        set_command_line(&mut ctx,line);
+        let a=GetCommandLineA(&mut ctx);let w=GetCommandLineW(&mut ctx);
+        assert_eq!(ctx.memory.read_cstr(a),line.as_bytes());
+        assert_eq!(ctx.memory.read_wstr(w).to_string_lossy(),line);
+        // Win32 RTL_USER_PROCESS_PARAMETERS.CommandLine is at byte 0x40.
+        assert_eq!(ctx.memory.read::<u16>(0x1940),line.len() as u16*2);
+        assert_eq!(ctx.memory.read::<u16>(0x1942),(line.len() as u16+1)*2);
+        assert_eq!(ctx.memory.read::<u32>(0x1944),w);
+    }
