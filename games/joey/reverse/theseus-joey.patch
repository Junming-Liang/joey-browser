+// Keep every slot and its exact stdcall arity, including unsupported methods.
+pub mod IDirectPlay8Peer {
+    use super::*;
+    pub static mut VTABLE:u32=0;
+    pub const VTABLE_ENTRIES:[&str;37]=[
+        "QueryInterface","AddRef","Release","Initialize","EnumServiceProviders","CancelAsyncOperation","Connect","SendTo",
+        "GetSendQueueInfo","Host","GetApplicationDesc","SetApplicationDesc","CreateGroup","DestroyGroup","AddPlayerToGroup",
+        "RemovePlayerFromGroup","SetGroupInfo","GetGroupInfo","EnumPlayersAndGroups","EnumGroupMembers","SetPeerInfo",
+        "GetPeerInfo","GetPeerAddress","GetLocalHostAddresses","Close","EnumHosts","DestroyPeer","ReturnBuffer",
+        "GetPlayerContext","GetGroupContext","GetCaps","SetCaps","SetSPCaps","GetSPCaps","GetConnectionInfo","RegisterLobby","TerminateSession",
+    ];
+    #[win32_derive::dllexport]
+    pub fn QueryInterface(ctx:&mut Context,this:u32,iid:u32,out:u32)->u32 {
+        if !valid(ctx,iid,16)||!valid(ctx,out,4) {return POINTER;}
+        ctx.memory.write::<u32>(out,0);let iid=ctx.memory.read::<GUID>(iid);
+        if iid!=IID_PEER&&iid!=IID_UNKNOWN {return NOINTERFACE;}
+        if AddRef(ctx,this)==0 {return INVALID;}
+        ctx.memory.write::<u32>(out,this);OK
+    }
+    #[win32_derive::dllexport]
+    pub fn AddRef(_ctx:&mut Context,this:u32)->u32 {
+        let mut s=state();let Some(p)=s.peers.get_mut(&this) else {return 0;};p.refs=p.refs.saturating_add(1);p.refs
+    }
+    #[win32_derive::dllexport]
+    pub fn Release(ctx:&mut Context,this:u32)->u32 {
+        let remaining={let mut s=state();let Some(p)=s.peers.get_mut(&this) else {return 0;};p.refs-=1;p.refs};
+        if remaining==0 {Close(ctx,this,0);state().peers.remove(&this);free(ctx,this);}remaining
+    }
+    #[win32_derive::dllexport]
+    pub fn Initialize(ctx:&mut Context,this:u32,context:u32,function:u32,flags:u32)->u32 {
+        if flags&!7!=0||!valid(ctx,function,1) {return INVALID;}
+        let id={
+            let mut s=state();let Some(p)=s.peers.get(&this) else {return INVALID;};
+            if p.transport!=0 {return 0x80158080;}
+            let id=next_id(&mut s);let p=s.peers.get_mut(&this).unwrap();
+            p.transport=id;p.polling=true;p.owner=ctx.thread_id;p.callback=function;p.context=context;id
+        };
+        let hr=rpc(id,1,&[],"",&[]);
+        if hr!=OK&&current(this,id) {state().peers.get_mut(&this).unwrap().transport=0;}hr
+    }
+    #[win32_derive::dllexport]
+    pub fn Close(ctx:&mut Context,this:u32,flags:u32)->u32 {
+        if flags&!1!=0 {return INVALID;}
+        let (id,buffers)={
+            let mut s=state();let Some(p)=s.peers.get_mut(&this) else {return INVALID;};
+            let id=p.transport;p.transport=0;p.callback=0;p.connected=false;p.polling=false;p.local=0;
+            p.players.clear();p.operations.clear();p.completions.clear();p.name.clear();
+            (id,p.buffers.drain().collect::<Vec<_>>())
+        };
+        // Invalidate before RPC: a pending reply must never touch a new session.
+        if id!=0 {rpc(id,9,&[],"",&[]);}
+        for p in buffers {free(ctx,p);}OK
+    }
+    #[win32_derive::dllexport]
+    pub fn SetPeerInfo(ctx:&mut Context,this:u32,info:u32,async_context:u32,handle:u32,flags:u32)->u32 {
+        let id=match transport(this) {Ok(id)=>id,Err(e)=>return e};
+        if flags!=SYNC {return NOTIMPL;}
+        if async_context!=0||handle!=0 {return INVALID;}
+        if !valid(ctx,info,24) {return POINTER;}
+        if ctx.memory.read::<u32>(info)!=24||ctx.memory.read::<u32>(info+4)&!1!=0 {return NOTIMPL;}
+        let name=match wide(ctx,ctx.memory.read::<u32>(info+8)) {Ok(s)=>s,Err(e)=>return e};
+        let hr=rpc(id,2,&[],&name,&[]);
+        if hr==OK&&current(this,id) {state().peers.get_mut(&this).unwrap().name=name;}hr
+    }
+    #[win32_derive::dllexport]
+    pub fn GetPeerInfo(ctx:&mut Context,this:u32,player:u32,out:u32,size:u32,flags:u32)->u32 {
+        if flags!=0 {return INVALID;}
+        if let Err(e)=transport(this) {return e;}
+        let player=state().peers.get(&this).and_then(|p|p.players.get(&player).cloned());
+        let Some(player)=player else {return INVALID_PLAYER;};
+        if !valid(ctx,size,4) {return POINTER;}
+        let name=utf16(&player.name);let required=24+name.len();let capacity=ctx.memory.read::<u32>(size) as usize;
+        ctx.memory.write::<u32>(size,required as u32);
+        if out==0||capacity<required {return SMALL;}
+        if !valid(ctx,out,required) {return POINTER;}
+        if ctx.memory.read::<u32>(out)!=24 {return INVALID;}
+        words(ctx,out,&[24,1,out+24,0,0,player.flags]);put(ctx,out+24,&name);OK
+    }
