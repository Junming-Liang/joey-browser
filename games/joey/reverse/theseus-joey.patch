diff --git a/runtime/src/cp932.rs b/runtime/src/cp932.rs
new file mode 100644
index 0000000..7474e8a
--- /dev/null
+++ b/runtime/src/cp932.rs
@@ -0,0 +1,40 @@
+//! Windows CP932 historical direct/best-fit mappings; browser Shift_JIS differs.
+const TABLE: &[u8; 262144] = include_bytes!("cp932.bin");
+fn lookup(offset: usize,value: u16) -> u16 {
+    let i = offset+value as usize*2;
+    u16::from_le_bytes([TABLE[i],TABLE[i+1]])
+}
+pub fn is_lead(byte: u8) -> bool {(0x81..=0x9f).contains(&byte)||(0xe0..=0xfc).contains(&byte)}
+pub fn decode_char(value: u16) -> u16 {lookup(0,value)}
+pub fn decode(bytes: &[u8]) -> (Vec<u16>,bool) {
+    let mut words = Vec::with_capacity(bytes.len());let mut invalid = false;let mut i = 0;
+    while i < bytes.len() {
+        let first = bytes[i];let mut value = first as u16;
+        if is_lead(first) {
+            if i+1 < bytes.len() && bytes[i+1] != 0 {value=(value<<8)|bytes[i+1] as u16;i+=1;}
+            else {invalid=true;}
+        }
+        let word=decode_char(value);
+        if word==0x30fb && value!=0x8145 {invalid=true;}
+        words.push(word);i+=1;
+    }
+    (words,invalid)
+}
+pub fn encode_char(word: u16,no_best_fit: bool) -> Option<u16> {
+    let value=lookup(131072,word);
+    if (no_best_fit||value==0x3f)&&decode_char(value)!=word {None}else {Some(value)}
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn microsoft_yen_best_fit_private_use_and_default() {
+        assert_eq!(encode_char(0x00a5,false),Some(0x5c));
+        assert_eq!(encode_char(0x00a5,true),None);
+        assert_eq!(decode_char(0x5c),0x5c);
+        assert_eq!(decode_char(0x8145),0x30fb);
+        assert_eq!(decode(&[0x81,0]).0,vec![0x30fb,0]);
+        assert_eq!(decode(&[0xf0,0x40]).0,vec![0xe000]);
+        assert_eq!(decode(&[0x93,0xfa,0x96,0x7b,0x8c,0xea]).0,vec![0x65e5,0x672c,0x8a9e]);
+    }
+}
