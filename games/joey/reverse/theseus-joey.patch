+        ctx.memory[0x1000..][..key_name.len()].copy_from_slice(key_name);
+        ctx.memory[0x1100..][..5].copy_from_slice(b"Flag\0");
+        assert_eq!(RegCreateKeyExA(&mut ctx, 0x80000002, 0x1000, 0, 0, 0, 0xf003f, 0, 0x1200, 0x1204), 0);
+        let key = ctx.memory.read::<u32>(0x1200);
+        assert_eq!(ctx.memory.read::<u32>(0x1204), 1);
+        ctx.memory.write::<u32>(0x1230, 0x12345678);
+        assert_eq!(RegSetValueExA(&mut ctx, key, 0x1100, 0, 4, 0x1230, 4), 0);
+        assert_eq!(RegCloseKey(&mut ctx, key), 0);
+        assert_eq!(RegCloseKey(&mut ctx, key), ERROR_INVALID_HANDLE);
