diff --git a/runtime/src/cp936.rs b/runtime/src/cp936.rs
new file mode 100644
index 0000000..9b97775
--- /dev/null
+++ b/runtime/src/cp936.rs
@@ -0,0 +1,48 @@
+//! Windows CP936 direct and best-fit tables, from Microsoft's public historical
+//! mapping (source/hash/generator kept in games/joey/reverse/generate_cp936.py).
+//! Browser GBK decoding is not a substitute for these Windows tables.
+mod composition { include!("cp936_composition.rs"); }
+const TABLE: &[u8; 262144] = include_bytes!("cp936.bin");
+fn lookup(offset: usize, value: u16) -> u16 {
+    let i = offset + value as usize * 2;
+    u16::from_le_bytes([TABLE[i],TABLE[i+1]])
+}
+pub fn decode_char(value: u16) -> u16 {lookup(0,value)}
+pub fn decode(bytes: &[u8]) -> (Vec<u16>,bool) {
+    let mut words = Vec::with_capacity(bytes.len()); let mut invalid = false; let mut i = 0;
+    while i < bytes.len() {
+        let first = bytes[i]; let mut value = first as u16;
+        if (0x81..=0xfe).contains(&first) {
+            if i+1 < bytes.len() && bytes[i+1] != 0 {
+                value = ((first as u16)<<8) | bytes[i+1] as u16; i += 1;
+            } else {invalid = true;}
+        }
+        let word = decode_char(value);
+        if word == 0x3f && value != 0x3f {invalid = true;}
+        words.push(word); i += 1;
+    }
+    (words,invalid)
+}
+pub fn encode_char(word: u16, no_best_fit: bool) -> Option<u16> {
+    let value = lookup(131072,word);
+    if (no_best_fit || value == 0x3f) && decode_char(value) != word {None} else {Some(value)}
+}
+pub fn compose(a: u16,b: u16) -> Option<u16> {
+    let key = ((a as u32)<<16) | b as u32;
+    composition::COMPOSITION.binary_search_by_key(&key,|entry|entry.0).ok().map(|i|composition::COMPOSITION[i].1)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn microsoft_dbcs_private_use_and_best_fit() {
+        assert_eq!(decode(&[0xd3,0xce,0xcf,0xb7,0xcd,0xf5]).0,vec![0x6e38,0x620f,0x738b]);
+        assert_eq!(decode(&[0x81,0]).0,vec![0x3f,0]);
+        assert_eq!(decode(&[0xff]).0,vec![0xf8f5]);
+        assert_eq!(decode(&[0x80]).0,vec![0x20ac]);
+        assert_eq!(encode_char(0x20ac,true),Some(0x80));
+        assert_eq!(compose(b'e' as u16,0x301),Some(0xe9));
+        assert!(encode_char(0x6e38,true).is_some());
+    }
+}
